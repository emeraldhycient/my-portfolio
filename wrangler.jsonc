// Cloudflare Worker that serves dist/ as static files. Deploy with `npm run deploy`.
{
  "name": "my-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "hycient.dev", "custom_domain": true },
    { "pattern": "www.hycient.dev", "custom_domain": true }
  ]
}
